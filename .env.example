# Copy into .env and supply real secrets locally. Never commit .env.
ENVIRONMENT=development
ADMIN_ENDPOINTS_ENABLED=true
DATABASE_URL=sqlite:///./newsletter.db
# Existing deployments may use PROD_DATABASE_URL instead; it takes precedence.
FRONTEND_URL=http://localhost:3000
# Optional comma-separated exact frontend origins; defaults to FRONTEND_URL.
# CORS_ORIGINS=http://localhost:3000
ADMIN_API_TOKEN=replace-with-a-long-random-secret
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AUTOMATION_MODE=preview
SCHEDULER_ENABLED=true
SCHEDULE_TIMEZONE=Europe/London
MORNING_HOUR=8
BEDTIME_HOUR=21
WORKER_POLL_SECONDS=10
MAX_OUTPUT_TOKENS=1000
RESEARCH_OUTPUT_TOKENS=1800
MAX_INPUT_TOKENS=16000
SEARCH_INPUT_TOKEN_ALLOWANCE=50000
REQUEST_BUDGET_USD=0.50
MONTHLY_BUDGET_USD=5.00
MAX_GENERATION_ATTEMPTS=3
INPUT_USD_PER_MILLION=3
OUTPUT_USD_PER_MILLION=15
SEARCH_USD=0.01
CHARACTERS_DIR=characters

# Existing Mailjet integration (also used for subscription confirmations).
EMAIL_TRANSPORT=mailjet
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER_EMAIL=
# To use your external MCP email tool: EMAIL_TRANSPORT=mcp, then fill these in.
# No credentials or MCP command were inferred from your separate SMTP/task API variables.
MCP_EMAIL_TOOL=
MCP_EMAIL_FIELDS={"recipient":"to","subject":"subject","text":"body"}
# Optionally map html and idempotency_key if your tool supports those parameters.
MCP_SERVER_URL=
MCP_SERVER_TOKEN=
# Alternatively use a local stdio server (command executable plus JSON args):
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=[]
